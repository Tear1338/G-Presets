+++ b/src/main/java/extension/tools/presetconfig/wired/PresetObjectVariables.java
@@ -0,0 +1,80 @@
+package extension.tools.presetconfig.wired;
+import gearth.protocol.HMessage;
+import gearth.protocol.HPacket;
+import java.util.*;
+import org.json.JSONObject;
+import org.json.JSONArray;
+/** Writable furniture properties and values of room variables defined by this preset. */
+public final class PresetObjectVariables {
+   public static final Set<String> BUILTINS=Set.of("-126","~113","~110","~111","~112","~100","~102","~101","~121","~146","~103");
+   public final int target,objectId;
+   public final Map<String,Integer> values;
+   private Set<String> furnitureReferenceKeys = new HashSet<>();
+   private Set<String> writeOnlyVariableIds = new HashSet<>();
+   public PresetObjectVariables(int target,int id,Map<String,Integer> values) {
+      if(target!=0 && target!=-10) throw new IllegalArgumentException("Unsupported preset variable holder");
+      for(String key:values.keySet()) if(key==null || key.isEmpty() || (target==0 && !BUILTINS.contains(key) && !PresetWiredBase.isLocalVariableId(key))) throw new IllegalArgumentException("Unknown writable furniture property");
+      this.target=target;this.objectId=id;this.values=Collections.unmodifiableMap(new LinkedHashMap<>(values));
+   }
+   public PresetObjectVariables(JSONObject j) {
+      this(j.getInt("target"),j.getInt("objectId"),read(j.getJSONObject("values")));
+      JSONArray writes=j.optJSONArray("writeOnlyVariableIds");
+      if(writes!=null) for(Object key:writes) { if(!values.containsKey(key)) throw new IllegalArgumentException("Unknown write-only variable");writeOnlyVariableIds.add(key.toString()); }
+      JSONArray refs=j.optJSONArray("furnitureReferenceKeys");
+      if(refs!=null) for(Object key:refs) {
+         if(!"~103".equals(key) || !values.containsKey(key)) throw new IllegalArgumentException("Unknown furniture reference property");
+         furnitureReferenceKeys.add(key.toString());
+      }
+   }
+   public PresetObjectVariables withWriteOnlyVariables(Set<String> ids) {
+      if(!values.keySet().containsAll(ids)) throw new IllegalArgumentException("Unknown write-only variable");
+      PresetObjectVariables copy=new PresetObjectVariables(toJsonObject());copy.writeOnlyVariableIds.addAll(ids);return copy;
+   }
+   public PresetObjectVariables withFurnitureReference(String key) {
+      if(!"~103".equals(key) || !values.containsKey(key)) throw new IllegalArgumentException("Unknown furniture reference property");
+      PresetObjectVariables copy=new PresetObjectVariables(toJsonObject());copy.furnitureReferenceKeys.add(key);return copy;
+   }
+   private static Map<String,Integer> read(JSONObject j) { Map<String,Integer> m=new LinkedHashMap<>();for(String key:j.keySet())m.put(key,j.getInt(key));return m; }
+   public PresetObjectVariables translate(int dx,int dy) {
+      Map<String,Integer> m=new LinkedHashMap<>(values);
+      if(m.containsKey("~110"))m.put("~110",Math.addExact(m.get("~110"),dx));
+      if(m.containsKey("~111"))m.put("~111",Math.addExact(m.get("~111"),dy));
+      PresetObjectVariables copy=new PresetObjectVariables(target,objectId,m);copy.furnitureReferenceKeys.addAll(furnitureReferenceKeys);copy.writeOnlyVariableIds.addAll(writeOnlyVariableIds);return copy;
+   }
+   public PresetObjectVariables remap(Map<Integer,Integer> furniture,Map<String,String> variables) {
+      Integer id=target==-10?0:furniture.get(objectId);
+      if(id==null) throw new IllegalArgumentException("Missing variable holder " + objectId);
+      Map<String,Integer> m=new LinkedHashMap<>();
+      for(Map.Entry<String,Integer> e:values.entrySet()) {
+         String key=target==0 && BUILTINS.contains(e.getKey())?e.getKey():variables.get(e.getKey());
+         if(key==null)throw new IllegalArgumentException("Unresolved room variable " + e.getKey());
+         Integer value=furnitureReferenceKeys.contains(e.getKey())?furniture.get(e.getValue()):e.getValue();
+         if(value==null)throw new IllegalArgumentException("Missing teleporter destination " + e.getValue());
+         m.put(key,value);
+      }
+      PresetObjectVariables copy=new PresetObjectVariables(target,id,m);
+      for(String old:writeOnlyVariableIds) copy.writeOnlyVariableIds.add(target==0 && BUILTINS.contains(old)?old:variables.get(old));
+      return copy;
+   }
+   /** Occupation is derived from the current furniture placement; restoring it moves furniture. */
+   public PresetObjectVariables withoutPlacementState() {
+      if(target!=0 || !values.containsKey("-126"))return this;
+      Map<String,Integer> kept=new LinkedHashMap<>(values);kept.remove("-126");
+      PresetObjectVariables copy=new PresetObjectVariables(target,objectId,kept);
+      copy.furnitureReferenceKeys.addAll(furnitureReferenceKeys);
+      copy.writeOnlyVariableIds.addAll(writeOnlyVariableIds);copy.writeOnlyVariableIds.remove("-126");
+      return copy;
+   }
+   public List<HPacket> packets() {
+      List<HPacket> packets=new ArrayList<>();
+      for(Map.Entry<String,Integer> e:values.entrySet())if(target!=0 || !"-126".equals(e.getKey()))packets.add(new HPacket("WiredSetObjectVariableValue",HMessage.Direction.TOSERVER,target,objectId,e.getKey(),e.getValue(),target==-10 || BUILTINS.contains(e.getKey()) || writeOnlyVariableIds.contains(e.getKey())?0:1));
+      return packets;
+   }
+   public JSONObject toJsonObject() { return new JSONObject().put("target",target).put("objectId",objectId).put("values",new JSONObject(values)).put("furnitureReferenceKeys",new JSONArray(furnitureReferenceKeys)).put("writeOnlyVariableIds",new JSONArray(writeOnlyVariableIds)); }
+   /** The clock pulse count can advance between a write and its inspection reply. */
+   public boolean onlyClockPulseUnconfirmed(Map<String,Integer> actual) {
+      return target==0 && values.containsKey("~121") && actual.containsKey("~121") && !matches(actual)
+         && values.entrySet().stream().filter(e->!e.getKey().equals("~121")).allMatch(e->e.getValue().equals(actual.get(e.getKey())));
+   }
+   public boolean matches(Map<String,Integer> actual) { return values.entrySet().stream().allMatch(e->e.getValue().equals(actual.get(e.getKey()))); }
+}
--- a/src/main/java/extension/tools/presetconfig/wired/PresetRoomLink.java
+++ b/src/main/java/extension/tools/presetconfig/wired/PresetRoomLink.java
@@ -0,0 +1,46 @@
+package extension.tools.presetconfig.wired;
+
+import gearth.protocol.HMessage;
+import gearth.protocol.HPacket;
+import java.util.Map;
+import java.util.Set;
+import org.json.JSONObject;
+
+/** ~103 is teleport.target_id (a furniture ID), never a room destination. */
+public final class PresetRoomLink {
+   public final int furniId;
+   public final String destination;
+   public final String destinationType;
+   private static final Set<String> TYPES=Set.of("legacy","furniture","externalFurniture","none","resolvedFurniture");
+   /** Old snapshots stored an absolute source-world furniture ID without its meaning. */
+   public PresetRoomLink(int id,String destination){this(id,destination,"legacy");}
+   private PresetRoomLink(int id,String destination,String type) {
+      this.furniId=id;this.destination=destination;this.destinationType=type;
+      if(destination==null || (!destination.isEmpty() && !destination.matches("[0-9]+")) || !TYPES.contains(type))throw new IllegalArgumentException("Invalid linked furniture destination");
+      if(!destination.isEmpty())Integer.parseInt(destination);
+      if(type.equals("none") && !destination.equals("0") || type.equals("furniture") && destination.isEmpty())throw new IllegalArgumentException("Invalid linked furniture reference");
+   }
+   public PresetRoomLink(JSONObject json){this(json.getInt("furniId"),json.getString("destination"),json.optString("destinationType","legacy"));if(destinationType.equals("resolvedFurniture"))throw new IllegalArgumentException("Resolved furniture IDs cannot be supplied by preset JSON");}
+   public static PresetRoomLink capture(int owner,int target,Map<Integer,Integer> furniture) {
+      Integer local=furniture.get(target);
+      return new PresetRoomLink(owner,Integer.toString(local!=null?local:target),local!=null?"furniture":target==0?"none":"externalFurniture");
+   }
+   public String unavailableReason(Map<Integer,Integer> furniture) {
+      if(!furniture.containsKey(furniId))return "Room linker furniture was not placed: "+furniId;
+      if(destinationType.equals("legacy"))return "Legacy room linker snapshot contains a source furniture ID, not a room ID; its native pairing is retained. Re-export to capture a portable local link";
+      if(destinationType.equals("externalFurniture"))return "Linked teleport furniture is outside this preset; native pairing retained";
+      if(destinationType.equals("furniture") && !furniture.containsKey(Integer.parseInt(destination)))return "Linked destination furniture was not placed: "+destination;
+      return null;
+   }
+   public PresetRoomLink remap(Map<Integer,Integer> furniture) {
+      String reason=unavailableReason(furniture);if(reason!=null)throw new IllegalStateException(reason);
+      int target=destinationType.equals("none")?0:destinationType.equals("resolvedFurniture")?Integer.parseInt(destination):furniture.get(Integer.parseInt(destination));
+      return new PresetRoomLink(furniture.get(furniId),Integer.toString(target),"resolvedFurniture");
+   }
+   public JSONObject toJsonObject(){JSONObject json=new JSONObject().put("furniId",furniId).put("destination",destination);if(!destinationType.equals("legacy"))json.put("destinationType",destinationType);return json;}
+   public PresetRoomLink withFurniId(int id){return new PresetRoomLink(id,destination,destinationType);}
+   public HPacket savePacket() {
+      if(!destinationType.equals("resolvedFurniture"))throw new IllegalStateException("Room linker furniture references must be resolved before saving");
+      return new HPacket("WiredSetObjectVariableValue",HMessage.Direction.TOSERVER,0,furniId,"~103",Integer.parseInt(destination),0);
+   }
+}
