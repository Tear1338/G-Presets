+      });
+      if(!done.await(20,TimeUnit.SECONDS))throw new AssertionError("JavaFX initialization timed out");
+      Platform.exit();
+      if(failure.get()!=null)throw new AssertionError("Packaged UI failed to load",failure.get());
+   }
