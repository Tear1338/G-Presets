+         return this.offerId;
+      }
+
+      public String getExtraParam() {
+         return this.extraParam;
+      }
+   }
+
+   public static enum CatalogState {
+      NONE,
+      AWAITING_INDEX,
+      COLLECTING_PAGES,
+      COLLECTED;
+
+      // $FF: synthetic method
+      private static CatalogState[] $values() {
+         return new CatalogState[]{NONE, AWAITING_INDEX, COLLECTING_PAGES, COLLECTED};
+      }
+   }
