+
+         });
+         this.workingPresetConfig.getFurniture().forEach((px) -> {
+            if (furniData.isStackable(px.getClassName()) && WiredKind.fromClassName(px.getClassName()) == WiredKind.TRIGGER && this.realFurniIdMap.containsKey(px.getFurniId())) {
+               moveList.add(px);
