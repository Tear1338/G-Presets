+            if (setting != null) {
+               for(HFloorItem stackTile : stackTiles) {
+                  this.allAvailableStackTiles.add(new StackTileInfo(stackTile.getId(), stackTile.getTile(), stackTile.getFacing().ordinal(), setting.getDimension()));
+               }
+            }
+         }
+      }
+
+   }
