+package extension.tools.presetconfig.wired;
+import java.util.*;
+/** Keep floor/wall namespaces distinct even when their native numeric IDs coincide. */
+public final class WiredFurnitureIds {
+   private WiredFurnitureIds() { }
+   public static Map<Integer,Integer> sourceMap(List<Integer> floor,List<Integer> walls) {
+      Map<Integer,Integer> ids=new LinkedHashMap<>();int next=1;
+      for(int id:floor) { if(id<=0 || ids.put(id,next++)!=null) throw new IllegalArgumentException("Invalid/duplicate floor object ID " + id); }
+      for(int id:walls) { if(id<=0 || ids.put(-id,-next++)!=null) throw new IllegalArgumentException("Invalid/duplicate wall object ID " + id); }
+      return ids;
+   }
+}
--- a/src/main/java/extension/tools/presetconfig/wired/WiredImportPlanner.java
+++ b/src/main/java/extension/tools/presetconfig/wired/WiredImportPlanner.java
@@ -0,0 +1,37 @@
+package extension.tools.presetconfig.wired;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+public final class WiredImportPlanner {
+   private WiredImportPlanner() { }
+
+   /** Put accessor variables before pointer/echo/reference definitions which consume them. */
+   public static List<PresetWiredVariable> orderVariables(List<PresetWiredVariable> variables) {
+      Set<String> defined = variables.stream().map(v -> v.variableId)
+         .filter(PresetWiredBase::isLocalVariableId).collect(Collectors.toSet());
+      Set<String> resolved = new HashSet<>();
+      List<PresetWiredVariable> remaining = new ArrayList<>(variables);
+      List<PresetWiredVariable> ordered = new ArrayList<>();
+      while (!remaining.isEmpty()) {
+         boolean progress = false;
+         for (int i = 0; i < remaining.size();) {
+            PresetWiredVariable variable = remaining.get(i);
+            if (variable.getVariableIds().stream().noneMatch(id -> defined.contains(id) && !variable.getExternalVariableIds().contains(id) && !resolved.contains(id))) {
+               ordered.add(variable);
+               if (variable.variableId != null) resolved.add(variable.variableId);
+               remaining.remove(i);
+               progress = true;
+            } else i++;
+         }
+         if (!progress) {
+            throw new IllegalArgumentException("Cyclic WIRED variable dependencies: " +
+               remaining.stream().map(PresetWiredVariable::getVariableName).collect(Collectors.joining(", ")));
+         }
+      }
+      return ordered;
+   }
+}
--- a/src/main/java/extension/tools/presetconfig/wired/WiredKind.java
+++ b/src/main/java/extension/tools/presetconfig/wired/WiredKind.java
@@ -0,0 +1,21 @@
+package extension.tools.presetconfig.wired;
+
+/** Classify by protocol family, never a frozen list of furniture sprite IDs. */
+public enum WiredKind {
+   TRIGGER("trg"), CONDITION("cnd"), EFFECT("act"), ADDON("xtra"), SELECTOR("slc"), VARIABLE("var"), NONE("");
+
+   private final String code;
+   WiredKind(String code) { this.code = code; }
+
+   public static WiredKind fromClassName(String name) {
+      if (name == null || !name.startsWith("wf_")) return NONE;
+      String suffix = name.substring(3);
+      if (suffix.startsWith("ltdproto_")) suffix = suffix.substring(9);
+      else if (suffix.startsWith("proto_")) suffix = suffix.substring(6);
+      if (suffix.startsWith("test_")) suffix = suffix.substring(5);
+      for (WiredKind kind : values()) {
+         if (kind != NONE && (suffix.equals(kind.code) || suffix.startsWith(kind.code + "_"))) return kind;
+      }
+      return NONE;
+   }
+}
