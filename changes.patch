+   }
+
+   public void setBytes(byte[] bytes) {
+      this.isEdited = true;
+      this.packetInBytes = bytes;
+   }
+
+   public String stringify() {
+      String st = null;
+      st = (this.isEdited ? "1" : "0") + new String(this.packetInBytes, StandardCharsets.ISO_8859_1);
