+         if (startAddingFurni) {
+            if (this.workingPresetConfig.getFurniture().isEmpty()) {
+               this.startWallOnlyImport();
+            } else {
+               this.state = GPresetImporter.BuildingImportState.ADD_UNSTACKABLES;
